{
  "name": "@atomiteam/atomi-editor",
  "version": "0.1.0",
  "description": "Framework-independent rich-text HTML editor with optional plugins",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./minimal": {
      "types": "./dist/types/minimal.d.ts",
      "import": "./dist/minimal.js"
    },
    "./medium": {
      "types": "./dist/types/medium.d.ts",
      "import": "./dist/medium.js"
    },
    "./full": {
      "types": "./dist/types/full.d.ts",
      "import": "./dist/full.js"
    },
    "./plugins/*": {
      "types": "./dist/types/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    },
    "./style.css": "./dist/style.css",
    "./browser/*": "./dist/browser/*"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "build:custom": "node scripts/build.mjs --custom",
    "test": "npm run build && node --test tests/browser.test.mjs",
    "demo": "npm run build && node scripts/serve.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomiteam/atomi-editor.git"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=22"
  }
}
